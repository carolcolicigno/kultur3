# Server-only secrets. Never use VITE_ prefixes for credentials.
GEMINI_API_KEY=
# Models remain configurable to support a controlled model upgrade.
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TEXT_MODEL=gemini-3.1-pro-preview
PORT=3000
# Required in production, minimum 16 characters. Pilot username: kultur3.
# Use HTTPS at the hosting proxy. This shared access is for the pilot, not customer accounts.
PILOT_PASSWORD=
# Optional local-only auth switch. Keep false/empty for easier local development.
PILOT_AUTH_LOCAL=
# Single-process pilot: mount a private persistent volume here in production.
DATA_DIR=.data
